# OnePortfolio environment template
# Copy to .env and fill values for your local machine or deployment.
# Do not commit .env.

# Required. Startup fails while this is blank. Generate one with:
#   python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=
# Blank uses the local SQLite file portfolio.db beside config.py, created and
# migrated automatically on first startup.
DATABASE_URL=

EMAIL_USER=
EMAIL_PASSWORD=
# `python app.py` selects development configuration before startup validation,
# so this local HTTP origin is accepted. Production must replace it with the
# externally reachable HTTPS origin.
APP_BASE_URL=http://127.0.0.1:5000

# Leave blank for automatic behavior; explicit values: 1/true or 0/false.
SESSION_COOKIE_SECURE=

# Blank uses process-local memory:// storage. Multi-process deployments need
# a shared Flask-Limiter backend plus its deployment-specific client/service.
RATELIMIT_STORAGE_URI=

DEV_AUTO_LOGIN=
FLASK_DEBUG=

GOOGLE_OAUTH_ENABLED=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=
